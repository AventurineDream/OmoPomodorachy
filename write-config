#!/usr/bin/env bash
# Atomically replace a verified regular file with content read from stdin.
# Usage: write-config [--create] [--expect] <file> < framed-input
#
# Stdin is one frame, "<byte count>\n<bytes>" (FocusdModel.js writeConfigInput
# builds it). With --expect it is two frames back to back: the expected
# current text, then the new text (writeConfigGuardedInput builds the pair).
# The content is not an argument: Linux refuses one argv string of 128 KiB or
# more (E2BIG), and the sessions log and Focus Log grow past that toward the
# 1 MiB cap. The script reads each count, then exactly that many bytes, and
# stops. It never waits for EOF: the Quickshell Process that feeds it does not
# reliably deliver EOF after a large write. Each frame is capped at 1 MiB,
# counted in bytes, and no frame is delimited by its content.
#
# --expect is compare-before-replace for the sessions log. The file must hold
# exactly the expected bytes (a missing file holds only the empty expected
# text). The compare is made before any temp file is created, and again just
# before the rename, so a change during the new text's write is caught too.
# If the file differs (a sync, a hand edit, another Focusd) nothing is written,
# the file is kept, and the script exits 3 (SESSIONS_CHANGED_EXIT in
# FocusdModel.js). The last compare and the rename are two system calls, so a
# writer that changes the file in between still wins: that window is one
# re-read of the file.
#
# Without --create the file must already exist (a missing config.toml is
# a failure, not a blank to fill in). With --create the file is created if
# it does not exist (mode 0644): the sessions log, focusd.json and the Focus
# Log use this, so the first write can start the file. Under --expect a
# missing file is created only when the expected text is empty. An existing
# file must be a regular file (never a symlink). The parent directory must
# exist and not be a symlink. Content over 1 MiB, counted in bytes, is refused
# before the file is touched. Writes to a temp file in the same directory,
# then renames. Exit 1 is any refusal; 3 is a conflict under --expect.
set -euo pipefail

# The write itself runs in Python. If it is missing, fail loudly (a
# silent failure would just look like the slider snapping back).
[[ -x /usr/bin/python3 ]] || { echo "write-config: /usr/bin/python3 is required but not found" >&2; exit 1; }

create=0
expect=0
while [[ "${1:-}" == --* ]]; do
  case "$1" in
    --create) create=1 ;;
    --expect) expect=1 ;;
    *) echo "write-config: unknown option $1" >&2; exit 1 ;;
  esac
  shift
done

file="${1:?file required}"
# Content is never an argument. An old caller that still passes it gets a
# clear refusal, not a silent write of the wrong thing.
[[ $# -eq 1 ]] || { echo "write-config: content goes on stdin, not as an argument" >&2; exit 1; }

[[ "$file" == /* ]] || exit 1
dir="${file%/*}"
[[ "$dir" == /* ]] || exit 1
[[ -d "$dir" ]] || exit 1
[[ ! -L "$dir" ]] || exit 1

# Python is passed with -c: stdin carries the content, so it cannot also
# carry the program (as a heredoc would).
py=$(cat <<'PY'
import os
import re
import stat as statmod
import sys
import tempfile

MAX_BYTES = 1048576
SESSIONS_CHANGED_EXIT = 3
path, create, expect = sys.argv[1], sys.argv[2] == "1", sys.argv[3] == "1"


def read_exact(fd, n):
    data = b""
    while len(data) < n:
        chunk = os.read(fd, min(65536, n - len(data)))
        if not chunk:
            break
        data += chunk
    return data


# A frame is "<digits>\n<bytes>". The header is read a byte at a time so
# nothing past it is consumed. A header that is not digits, or a count over
# the cap, exits before the file is touched.
def read_frame():
    header = b""
    while not header.endswith(b"\n"):
        if len(header) >= 9:
            sys.exit(1)
        c = os.read(0, 1)
        if not c:
            sys.exit(1)
        header += c
    if not re.fullmatch(rb"[0-9]{1,8}\n", header):
        sys.exit(1)
    size = int(header[:-1])
    if size > MAX_BYTES:
        sys.exit(1)
    data = read_exact(0, size)
    if len(data) != size:
        sys.exit(1)
    return data


# True when the file at p holds exactly expected; a missing file holds b"".
# A symlink, a non-regular file, or a file that cannot be read never matches.
# The read takes one byte past the cap: a longer file cannot equal a capped base.
def holds(p, expected):
    try:
        fd = os.open(p, os.O_RDONLY | os.O_NOFOLLOW)
    except FileNotFoundError:
        return expected == b""
    except OSError:
        return False
    try:
        if not statmod.S_ISREG(os.fstat(fd).st_mode):
            return False
        return read_exact(fd, MAX_BYTES + 1) == expected
    except OSError:
        return False
    finally:
        os.close(fd)


def remove_quietly(p):
    try:
        os.unlink(p)
    except OSError:
        pass


expected = read_frame() if expect else None
content = read_frame()

mode = 0o644
try:
    fd = os.open(path, os.O_RDWR | os.O_NOFOLLOW)
except FileNotFoundError:
    if not create:
        sys.exit(1)
    if expect:
        # Not created here. The rename creates it only if the file is still
        # missing and the expected text was empty, so a refused write leaves
        # no empty file behind.
        fd = None
    else:
        # The file does not exist yet. Create it: O_CREAT|O_EXCL refuses if
        # the path appears in the meantime, including as a symlink, so nothing
        # is followed.
        fd = os.open(path, os.O_RDWR | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o644)
except OSError:
    sys.exit(1)
if fd is not None:
    try:
        st = os.fstat(fd)
        if not statmod.S_ISREG(st.st_mode):
            sys.exit(1)
        mode = statmod.S_IMODE(st.st_mode)
    finally:
        os.close(fd)

# The first compare: a changed file is refused before any temp file exists.
if expect and not holds(path, expected):
    sys.exit(SESSIONS_CHANGED_EXIT)

directory = os.path.dirname(path)
fd, tmp = tempfile.mkstemp(prefix=".write-config-", dir=directory)
try:
    with os.fdopen(fd, "wb") as f:
        f.write(content)
        f.flush()
        os.fsync(f.fileno())
    os.chmod(tmp, mode)
    # The last compare, just before the rename. It catches a change made while
    # the new text was being written and synced.
    if expect and not holds(path, expected):
        remove_quietly(tmp)
        sys.exit(SESSIONS_CHANGED_EXIT)
    os.replace(tmp, path)
except OSError:
    remove_quietly(tmp)
    sys.exit(1)
PY
)
exec /usr/bin/python3 -c "$py" "$file" "$create" "$expect"
